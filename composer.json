{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bezhansalleh/filament-shield": "^4.3",
        "dutchcodingcompany/filament-developer-logins": "^2.1",
        "filament/filament": "^5.8.4",
        "filament/spatie-laravel-settings-plugin": "^5.8",
        "lara-zeus/spatie-translatable": "^2.0",
        "laravel/framework": "^13.17.0",
        "laravel/tinker": "^3.0.0",
        "lucascudo/laravel-pt-br-localization": "^3.0",
        "pxlrbt/filament-activity-log": "^3.1",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-settings": "^3.9",
        "spatie/laravel-translatable": "^6.14",
        "tomatophp/filament-language-switcher": "^5.0",
        "valentin-morice/filament-json-column": "^4.1"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "barryvdh/laravel-ide-helper": "^3.7",
        "brianium/paratest": "^7.20",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.12",
        "laravel/boost": "^2.10.0",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.68.0",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^12.5.12",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-install-cmd": [
            "@php -r 'if (is_dir(\".git\")) { $git = shell_exec(\"command -v git 2>/dev/null\"); if ($git) { exec(\"git config --local core.hooksPath .githooks\");  echo \"Git Hooks Instalados\"; } }'",
            "@php -r 'if (is_dir(\".git\")) { exec(\"git config --local merge.lang-json.driver \\\"php .githooks/merge-lang.php %O %A %B\\\"\"); echo \"Merge driver de traduções configurado\"; }'"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php -r 'if (is_dir(\".git\")) { $git = shell_exec(\"command -v git 2>/dev/null\"); if ($git) { exec(\"git config --local core.hooksPath .githooks\"); echo \"Git Hooks Instalados\"; } }'",
            "@php -r 'if (is_dir(\".git\")) { exec(\"git config --local merge.lang-json.driver \\\"php .githooks/merge-lang.php %O %A %B\\\"\"); echo \"Merge driver de traduções configurado\"; }'"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
